rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'dollarcraft3@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{userId} {
      allow get: if ownsProfile(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if ownsProfile(userId)
        && request.resource.data.keys().hasAll([
          'email', 'firstName', 'lastName', 'name', 'createdAt', 'balanceCents'
        ])
        && request.resource.data.keys().hasOnly([
          'email', 'firstName', 'lastName', 'name', 'createdAt', 'balanceCents'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName is string
        && request.resource.data.name is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.balanceCents is int
        && request.resource.data.balanceCents == 0;

      allow update: if (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balanceCents'])
        && request.resource.data.balanceCents is int
        && request.resource.data.balanceCents >= 0
      ) || (
        ownsProfile(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balanceCents'])
        && request.resource.data.balanceCents is int
        && request.resource.data.balanceCents >= 0
        && request.resource.data.balanceCents < resource.data.balanceCents
      );

      allow delete: if false;
    }
  }
}
